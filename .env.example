# 复制本文件为 .env 并填写真实值。.env 已被 .gitignore 忽略，不会提交。
#
# 说明：Windows 环境变量大小写不敏感，因此设为 mysql_password 亦可被
# os.getenv('MYSQL_PASSWORD') 读到。但为跨平台一致（Linux/macOS 区分大小写），
# 建议统一使用下面的大写写法。

# ---------- 数据库（必填）----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=evaluation_db

# ---------- 模型 API（按需填写，缺失时对应模型不可用）----------
# 通义千问 Qwen-VL-Max
DASHSCOPE_API_KEY=
# Google Gemini（经 GRSAI 兼容网关）
GRSAI_API_KEY=
# 火山引擎 Doubao
ARK_API_KEY=

# ---------- 可选 ----------
# 数据集图片目录。默认 ./data/images
# VLM_BENCH_IMAGE_DIR=/path/to/images
# 飞书机器人通知（pipeline.py）
FEISHU_APP_SECRET=
